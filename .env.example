# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL / pgvector ---
POSTGRES_DB=incident_platform
POSTGRES_USER=incident_platform
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092

# --- Google Gemini API (analysis generation only) ---
# Get a key at https://aistudio.google.com/apikey. Embeddings run locally, so ingestion and
# retrieval need no key; this is required only for incident analysis.
# Called through Gemini's OpenAI-compatible endpoint, so the app uses Spring AI's OpenAI client.
GEMINI_API_KEY=changeme
# Development default has the larger free-tier daily allowance; switch to gemini-3.8-flash for
# final/demo runs (smaller daily allowance, stronger model).
AI_CHAT_MODEL=gemini-3.5-flash-lite

# --- AWS (S3 document storage, CloudWatch metrics) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_S3_BUCKET=incident-platform-documents

# --- Keycloak (added in the security milestone) ---
KEYCLOAK_REALM=incident-platform
KEYCLOAK_CLIENT_ID=incident-platform-frontend
KEYCLOAK_CLIENT_SECRET=changeme
