# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL / pgvector ---
POSTGRES_DB=incident_platform
POSTGRES_USER=incident_platform
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=9092

# --- OpenAI (chat/generation only) ---
# Embeddings run locally via an in-process ONNX model, so ingestion and retrieval need no key.
# This key is required only for the analysis and chat features.
OPENAI_API_KEY=sk-changeme
OPENAI_CHAT_MODEL=gpt-5.4-mini

# --- Anthropic (used only for the Day-14-equivalent evaluation comparison, not the main build) ---
ANTHROPIC_API_KEY=sk-ant-changeme

# --- AWS (S3 document storage, CloudWatch metrics) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_S3_BUCKET=incident-platform-documents

# --- Keycloak (added in the security milestone) ---
KEYCLOAK_REALM=incident-platform
KEYCLOAK_CLIENT_ID=incident-platform-frontend
KEYCLOAK_CLIENT_SECRET=changeme
